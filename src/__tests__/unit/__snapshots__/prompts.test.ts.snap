exports[`reply to a comment 1`] = `
--- message 1 ---
A reader commented on one of your blog posts. Write a short, thoughtful reply of at most 50 words, in your own voice and in the first person. Engage with what they actually said. Use plain text with no title or headings, and address them by name only if it feels natural.

<post>
Title: Walks

Dogs love walks.
</post>

<comment author="Sam">
Nice post!
</comment>
`;

exports[`research 1`] = `
--- message 1 ---
You're about to write a blog post from this outline:

Outline: why dogs wag their tails

Do some light research first: a few searches at most. Then reply with brief notes in plain text: 3 to 5 accurate, current facts, figures or quotes worth using, each with the name of its source. No introduction and no draft of the post.
`;

exports[`the post schema the AI must answer with 1`] = `
"{
  "name": "blog_post",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "The title of the article."
      },
      "content": {
        "type": "string",
        "description": "The content of the article. Must be written in markdown format."
      },
      "tags": {
        "type": "array",
        "description": "List of tags associated with the article",
        "items": {
          "type": "string",
          "description": "A tag that relates to the content of the article."
        }
      },
      "keywords": {
        "type": "array",
        "description": "Keywords that are relevant to the article for SEO purposes.",
        "items": {
          "type": "string",
          "description": "A keyword that describes the content of the article."
        }
      }
    },
    "required": [
      "title",
      "content",
      "tags",
      "keywords"
    ],
    "additionalProperties": false
  }
}"
`;

exports[`write the post with research notes 1`] = `
--- message 1 ---
Write a new article using the following outline and instructions.

--- message 2 ---
OUTLINE:
        Outline: why dogs wag their tails

--- message 3 ---
RESEARCH NOTES (background from the web: use what helps, in your own words):
<research>
Fact one (Source A). Fact two (Source B).
</research>

--- message 4 ---
INSTRUCTIONS:
        1. Expand upon the topic until you reach 700 words.
        2. Format your response according to the supplied JSON schema.
        3. In the "content": field, be sure to write in markdown to make rendering easier later.
`;

