{
  "compilerOptions": {
    "target": "ES2018",
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "./src",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // Start loose; tighten to "strict": true in a follow-up
    "strict": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__"]
}
